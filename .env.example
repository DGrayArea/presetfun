# Solana. DBC launches run on mainnet only.
SOLANA_CLUSTER=mainnet-beta
# A keyed RPC (Helius, Triton…). Stays on the server; the browser goes through /api/rpc.
SOLANA_RPC_URL=

# Logo + metadata pinning (Pinata v3 JWT). Without it, launching is paused.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Upstash Redis REST — the preset marketplace listing and rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional platform fees. With no wallet set, presetfun charges nothing.
PLATFORM_FEE_WALLET=
FEE_LAUNCH_SOL=0
FEE_TRADE_PCT=0
FEE_CLAIM_SOL=0
